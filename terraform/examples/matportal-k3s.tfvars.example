profile      = "matportal"
namespace    = "matportal"
release_name = "matportal"
additional_values_files = [
  "values/profiles/k3s-local.yaml",
  "values/addons/matomo.yaml",
  "values/addons/fairness.yaml",
  "values/addons/monitoring-servicemonitor.yaml"
]
enable_monitoring      = true
enable_trivy_operator  = true
enable_sonarqube       = false
set_sensitive_values = {
  "secrets.apiKey"              = "replace-with-a-long-random-token"
  "secrets.admin.password"      = "replace-with-an-admin-password"
  "secrets.mysqlRootPassword"   = "replace-with-a-db-password"
  "secrets.matomoDbPassword"    = "replace-with-a-matomo-password"
  "secrets.matomoDbRootPassword"= "replace-with-a-matomo-root-password"
}


# Optional platform add-ons. Enable only after reviewing docs/production-readiness.md.
# enable_keda              = true
# enable_vpa               = true
# enable_monitoring        = true
# enable_loki              = true
# enable_grafana_alloy     = true
# enable_trivy_operator    = true
# enable_sonarqube         = false
# enable_cert_manager      = true
# enable_external_secrets  = true
# enable_kyverno           = false
# enable_velero            = false
# velero_values_file       = "values/sites/velero-provider.yaml"

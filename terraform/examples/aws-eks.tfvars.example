# Deploy to an existing AWS EKS cluster. This module does not create the cluster.
# Install/configure AWS Load Balancer Controller, EBS CSI, and optional EFS CSI
# outside this module before enabling the matching values overlays.
profile = "agroportal-clean"
namespace = "agroportal"
release_name = "agroportal"
create_namespace = true
additional_values_files = [
  "values/profiles/production-recommended.yaml",
  "values/cloud/aws-eks.yaml",
  # Add for API/UI horizontal scaling after creating/testing efs-sc:
  # "values/cloud/aws-eks-rwx-efs.example.yaml",
  # Add site-specific hosts/secrets/image pins:
  # "values/sites/agroportal-prod.yaml",
]
enable_cert_manager = true
enable_external_secrets = true
enable_monitoring = true
enable_keda = false
enable_vpa = false

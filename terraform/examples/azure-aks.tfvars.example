# Deploy to an existing Azure AKS cluster. This module does not create the cluster.
# Install/configure Application Gateway Ingress Controller or replace the ingress
# overlay with the controller used by your AKS platform.
profile = "matportal"
namespace = "matportal"
release_name = "matportal"
create_namespace = true
additional_values_files = [
  "values/profiles/production-recommended.yaml",
  "values/cloud/azure-aks.yaml",
  # Add for API/UI horizontal scaling after testing Azure Files CSI:
  # "values/cloud/azure-aks-rwx-files.example.yaml",
  # Add site-specific hosts/secrets/image pins:
  # "values/sites/matportal-prod.yaml",
]
enable_cert_manager = true
enable_external_secrets = true
enable_monitoring = true
enable_keda = false
enable_vpa = false
